# Optional: an independent OpenAI-compatible text embedding endpoint.
# If omitted, an official Alibaba chat endpoint/key can be reused server-side.
# Set BOTH fields when using a separate endpoint. Never put these in VITE_*.
# RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=1024
RAG_MIN_SCORE=0.35
RAG_RECALL_K=20
# Native Alibaba rerank URL/key are derived from the embedding configuration.
# An explicit URL requires its own key. This is the full DashScope rerank endpoint.
# RAG_RERANK_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=qwen3-rerank
# Evidence sufficiency judge defaults to the current chat model and credentials.
# An explicit base URL requires its own key.
# RAG_JUDGE_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# RAG_JUDGE_API_KEY=
# RAG_JUDGE_MODEL=qwen3.7-plus
# RAG_STORAGE_DIR=/absolute/persistent/path/knowledge
